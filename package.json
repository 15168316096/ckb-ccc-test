{
  "name": "ckb-ccc-test",
  "version": "1.0.0",
  "description": "CKB CCC SDK integration tests for devnet, testnet, and mainnet",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:dev": "CKB_NETWORK=devnet jest",
    "test:testnet": "CKB_NETWORK=testnet jest",
    "test:mainnet": "CKB_NETWORK=mainnet jest --testPathPattern=readonly",
    "test:multisig": "jest --testPathPattern=multisig",
    "test:feepayer": "jest --testPathPattern=feePayer",
    "test:basic": "jest --testPathPattern=basicTransfer",
    "test:readonly": "jest --testPathPattern=readonly",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "ckb",
    "ccc",
    "nervos",
    "multisig",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ckb-ccc/core": "^1.1.25",
    "@ckb-ccc/ccc": "^1.1.25"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
