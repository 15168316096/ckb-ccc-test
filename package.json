{
  "name": "ckb-ccc-test",
  "version": "1.0.0",
  "description": "CKB CCC SDK integration tests for devnet, testnet, and mainnet",
  "type": "module",
  "scripts": {
    "test": "jest --forceExit",
    "test:dev": "CKB_NETWORK=devnet jest --forceExit",
    "test:testnet": "CKB_NETWORK=testnet jest --forceExit",
    "test:mainnet": "CKB_NETWORK=mainnet jest --testPathPattern=readonly --forceExit",
    "test:multisig": "jest --testPathPattern=multisig --forceExit",
    "test:feepayer": "jest --testPathPattern=feePayer --forceExit",
    "test:basic": "jest --testPathPattern=basicTransfer --forceExit",
    "test:readonly": "jest --testPathPattern=readonly --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "build": "tsc --noEmit",
    "test:dao": "tsx src/dao-devnet.ts",
    "ci:dao": "npm run build && ./run-dao-devnet.sh"
  },
  "keywords": [
    "ckb",
    "ccc",
    "nervos",
    "multisig",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ckb-ccc/ccc": "^1.1.25",
    "@ckb-ccc/core": "1.12.5",
    "@offckb/cli": "0.4.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "4.19.2",
    "typescript": "^5.3.3"
  }
}
